# Must match GitHub Settings -> Webhooks -> Secret; also used as the Jenkins shared-header secret.
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# Shared only with the optional GitHub Actions failed-job log collector; use a separate long random value.
CI_DIAGNOSTICS_COLLECTOR_SECRET=replace-with-a-separate-long-random-collector-secret
# Browser-visible API origin for a remote dashboard deployment, e.g. https://api.example.edu.
VITE_API_BASE_URL=http://localhost:8000
# Comma-separated browser origins allowed to call the API; set this to the deployed dashboard origin.
CORS_ALLOW_ORIGINS=http://localhost:5173
